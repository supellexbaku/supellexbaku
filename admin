"use client";

import { useState } from "react";

export default function AdminPage() {
  const [link, setLink] = useState("");

  const elaveEt = async () => {
    const onceki = JSON.parse(localStorage.getItem("katalog")) || [];

    const yeni = [
      ...onceki,
      {
        sekil: link,
      },
    ];

    localStorage.setItem("katalog", JSON.stringify(yeni));

    alert("Əlavə edildi");
    setLink("");
  };

  return (
    <div className="p-10">
      <h1 className="text-3xl font-bold mb-5">Admin Panel</h1>

      <input
        type="text"
        placeholder="Cloudinary linki"
        value={link}
        onChange={(e) => setLink(e.target.value)}
        className="border p-3 w-full rounded-xl mb-4"
      />

      <button
        onClick={elaveEt}
        className="bg-black text-white px-6 py-3 rounded-xl"
      >
        Əlavə et
      </button>
    </div>
  );
}
